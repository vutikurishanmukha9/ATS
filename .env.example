# Database (Neon PostgreSQL connection string)
# Example: postgresql://username:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Application Secret Key (Generate with: openssl rand -hex 32)
SECRET_KEY=replace-with-a-very-long-and-secure-random-secret-key-32-chars-minimum

# Environment (development | production)
ENVIRONMENT=production

# CORS allowed origins (comma separated or *)
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# Security Settings
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# First User Bootstrap (Automatically created on container startup if specified)
FIRST_USER_EMAIL=recruiter@company.com
FIRST_USER_PASSWORD=ChangeMeSecurely123!
FIRST_USER_NAME=Lead Recruiter
